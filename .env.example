# Server Configuration
PORT=3001
NODE_ENV=production

# Admin Authentication
# Set your secure administrative password here (plain text for initial setup, which the server securely hashes with bcrypt)
# Alternatively, you can set ADMIN_PASSWORD_HASH directly.
ADMIN_PASSWORD=change_this_to_your_secure_password

# JWT Secret for authenticating admin sessions (use a 64+ char random string in production)
JWT_SECRET=super_secure_random_jwt_secret_key_tope_2026_leader_portal_auth

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

