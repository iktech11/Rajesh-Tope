# Server Configuration
PORT=3001
NODE_ENV=production

# Admin Authentication
# Set your secure administrative password here (plain text for initial setup, which the server securely hashes with bcrypt)
ADMIN_PASSWORD=change_this_to_your_secure_password

# JWT Secret for authenticating admin sessions (use a 64+ char random string in production)
JWT_SECRET=super_secure_random_jwt_secret_key_tope_2026_leader_portal_auth

# Database Configuration (MongoDB Atlas)
# In production on Render, set this to your MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/rajesh_tope_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/rajesh_tope_db?retryWrites=true&w=majority

# CORS Configuration (Optional: specify comma-separated allowed origins if frontend is separate)
ALLOWED_ORIGINS=https://your-custom-domain.com

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
